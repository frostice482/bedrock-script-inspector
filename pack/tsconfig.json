{
	"compilerOptions": {
		"lib": ["ES2020"],
		"target": "ES2022",
		"module": "ES2022",

		"moduleResolution": "node",
		"skipLibCheck": true,
		"paths": {
			"@type/*": ["../../globaltypes/*"],
			"@override": ["override/index"],
			"@client": ["inspector/client"],
			"@/*": ["lib/*"],
		},

		"baseUrl": "src",
		"rootDir": "src",
		"outDir": "scripts",
		"allowJs": true,
		"removeComments": true,

		"strict": true,
		"noImplicitThis": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true
	},
	"include": ["src", "../globaltypes"]
}
