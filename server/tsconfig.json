{
	"compilerOptions": {
		"lib": ["esnext"],
		"target": "esnext",
		"module": "esnext",

		"moduleResolution": "node",
		"skipLibCheck": true,
		"paths": {
			"#*": ["./src/*"],
			"@globaltypes/*": ["../globaltypes/*"]
		},

		"rootDir": "src",
		"outDir": "app",
		"allowJs": true,
		"removeComments": true,

		"strict": true,
		"noImplicitThis": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src", "../globaltypes"]
}
